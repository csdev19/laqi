---
// apps/site/src/components/McpSection.astro
// Concrete and file-oriented on purpose: the MCP server operates on the
// mock files in its working directory — it is not a hosted service.
const flow = [
  { text: 'Order.ts / openapi.yaml', color: 'var(--viol)' },
  { text: 'agent via laqi mcp', color: 'var(--mint)' },
  { text: 'laqi/orders.json', color: 'var(--fg)' },
  { text: 'panel · your team flips states', color: 'var(--mag)' },
]
---
<section class="mcp-section">
  <div class="prose">
    <p class="eyebrow">built for AI-assisted workflows</p>
    <h2>Let your agent build the mocks.<br />Keep control of the states.</h2>
    <p>
      laqi’s MCP server gives coding agents tools to create endpoints,
      import OpenAPI, generate realistic data, and switch responses. The
      result is still ordinary JSON and a local panel your team can
      inspect.
    </p>
    <a href="/docs/ai-agents/" class="link">Using laqi with AI agents →</a>
  </div>
  <ol class="flow">
    {flow.map((step, i) => (
      <li>
        <span class="index">{i + 1}</span>
        <code style={`color: ${step.color}`}>{step.text}</code>
      </li>
    ))}
  </ol>
</section>

<style>
  .mcp-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  @media (max-width: 48rem) {
    .mcp-section {
      grid-template-columns: 1fr;
    }
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--viol);
    margin-bottom: 0.75rem;
  }
  h2 {
    font-family: var(--serif);
    font-size: 2rem;
    color: var(--fg);
    margin: 0 0 1.25rem;
  }
  .prose p {
    color: var(--dim);
    line-height: 1.6;
  }
  .link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--mono);
    color: var(--mint);
    text-decoration: none;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-self: center;
  }
  .flow li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .index {
    font-family: var(--mono);
    color: var(--dim2);
  }
  .flow code {
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>
