---
// UNUSED since 2026-10-02. Superseded by the nine-chapter home in
// src/components/home/; nothing under src/pages/ imports it, directly or
// transitively. Kept rather than deleted in the same change that replaced it,
// so the old page can still be read while the new one settles.
//
// Delete on or after 2026-11-02 if it is still unreferenced. Verify first —
// `grep -rl <name> src/` from apps/site — rather than trusting this header.
// apps/site/src/components/Hero.astro
import Demo from './Demo.astro'
import { demos, isVisible } from '../lib/demos'

// The CTA and the slot stand or fall together: a "watch the demo" button that
// scrolls to nothing is worse than no button.
const showDemo = isVisible(demos.hero)

// The evidence line under the lede reuses the panel's response-chip motif:
// each state a visitor will want to force, in the colors the panel gives
// that kind of response.
const states = [
  { label: 'empty cart', color: 'var(--mint)' },
  { label: 'unauthorized user', color: 'var(--warn)' },
  { label: '3s latency', color: 'var(--mag)' },
  { label: 'checkout failed', color: 'var(--red)' },
]
---
<section class="hero">
  <p class="eyebrow">local API control for frontend teams</p>
  <h1>Your backend isn’t ready.<br />Your frontend can be.</h1>
  <p class="lede">
    Create a controllable local API from JSON, models, or OpenAPI. Then
    flip any response, error, delay, or whole scenario from one panel.
  </p>
  <p class="evidence">
    {states.map((s, i) => (
      <>
        {i > 0 && <span class="sep">·</span>}
        <span class="chip" style={`--chip: ${s.color}`}>{s.label}</span>
      </>
    ))}
    <span class="evidence-tail">— one click away.</span>
  </p>
  <div class="cta-row">
    <a href="/docs/quick-start/" class="btn-primary">Quick start</a>
    {showDemo && <a href="#demo" class="btn-secondary">Watch the 20-second demo</a>}
  </div>
  <p class="badges">
    <span>no account</span>
    <span>no cloud by default</span>
    <span>one base URL, nothing else</span>
    <span>one binary</span>
  </p>
  {showDemo && (
    <div id="demo">
      <Demo {...demos.hero} />
    </div>
  )}
</section>

<style>
  .hero {
    max-width: 56rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
    text-align: center;
    background: radial-gradient(ellipse at top, color-mix(in srgb, var(--vio) 12%, transparent), transparent 60%);
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--viol);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.15;
    color: var(--fg);
    margin: 0 0 1.5rem;
  }
  .lede {
    max-width: 40rem;
    margin: 0 auto 1.5rem;
    color: var(--dim);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 auto 2rem;
    font-family: var(--mono);
    font-size: 0.8rem;
  }
  .chip {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--chip) 45%, transparent);
    border-radius: 999px;
    color: var(--chip);
    background: color-mix(in srgb, var(--chip) 8%, transparent);
  }
  .sep {
    color: var(--faint);
  }
  .evidence-tail {
    color: var(--dim);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .btn-primary {
    padding: 0.85rem 1.5rem;
    background: var(--vio);
    color: var(--fg);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--mono);
    font-weight: 600;
  }
  .btn-secondary {
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--bd2);
    color: var(--fg);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--mono);
  }
  /* The gap below the badges belongs to the demo, not to the badges: with no
     recording the badges are the hero's last element and the section's own
     padding is the right spacing. */
  #demo {
    margin-top: 3rem;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--faint);
    margin-bottom: 0;
  }
</style>
