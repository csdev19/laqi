---
// apps/site/src/components/home/TheName.astro
//
// The name on the home page, where it does recognition work: an English
// speaker hears "lucky" and otherwise never learns the product is named after
// a courier who carried a message ahead of the thing it stood for.
//
// The figure is a quipu drawn as line work whose last cord ends in the laqi
// mark. It is drawn in SVG rather than shipped as an image so it themes with
// the tokens and costs no bytes — and so this section never becomes another
// empty placeholder waiting for an asset that was not made.
//
// The internal letter-by-letter derivation spells LUQI rather than LAQI, so
// it is left out here as it is on /the-name/.
const cords = [
  { x: 24, len: 86, knots: [34, 58] },
  { x: 52, len: 62, knots: [40] },
  { x: 80, len: 104, knots: [30, 52, 78] },
  { x: 108, len: 70, knots: [46] },
  { x: 136, len: 92, knots: [38, 66] },
]
---

<section class="name" id="name">
  <figure class="figure">
    <div class="panes">
      <div class="pane">
        <svg viewBox="0 0 160 190" role="img" aria-label="A running courier in thin line work, a knotted cord in one hand.">
          <circle cx="100" cy="34" r="11" class="stroke" />
          <path d="M95 46 L78 96" class="stroke" />
          <path d="M78 96 L62 136 L44 170" class="stroke" />
          <path d="M78 96 L102 128 L124 152" class="stroke" />
          <path d="M92 60 L120 52 L132 66" class="stroke" />
          <path d="M90 66 L58 80" class="stroke" />
          <line x1="58" y1="80" x2="42" y2="74" class="stroke" />
          <line x1="42" y1="74" x2="42" y2="112" class="stroke thin" />
          <line x1="34" y1="76" x2="34" y2="100" class="stroke thin" />
          <line x1="50" y1="76" x2="50" y2="106" class="stroke thin" />
          <circle cx="42" cy="90" r="2.2" class="knot" />
          <circle cx="34" cy="88" r="2.2" class="knot" />
          <circle cx="50" cy="94" r="2.2" class="knot" />
        </svg>
      </div>

      <div class="pane pane-quipu">
        <p class="pane-label">quipu → mark</p>
        <svg viewBox="0 0 200 150" role="img" aria-label="A quipu: a horizontal cord with knotted cords hanging from it, the last ending in the laqi mark.">
          <line x1="16" y1="24" x2="168" y2="24" class="spine" />
          {
            cords.map((cord) => (
              <>
                <line x1={cord.x} y1="24" x2={cord.x} y2={24 + cord.len} class="cord" />
                {cord.knots.map((y) => <circle cx={cord.x} cy={24 + y} r="2.6" class="knot" />)}
              </>
            ))
          }
          <line x1="168" y1="24" x2="168" y2="52" class="cord" />
          <path d="M172 52 l-10 20 h7 l-5 16 14 -22 h-7 z" class="mark" />
        </svg>
      </div>
    </div>
    <figcaption>
      <span>fig. 1 — chasqui, in transit</span>
      <span class="sep">/</span>
      <span>the cord it carries ends in the laqi mark</span>
    </figcaption>
  </figure>

  <div class="prose">
    <p class="eyebrow">the name</p>
    <h2>A runner, ahead of the road.</h2>
    <p>
      The <em>chasqui</em> was a relay runner of the Inca road network, carrying
      knotted-cord quipus and spoken messages between waystations across the
      Andes.
    </p>
    <p>
      laqi plays the same part for your team. It carries the agreed message —
      the API contract — before the final implementation exists.
    </p>
    <p class="pull">
      <em>laqi is the runner carrying a message that is deliberately not the
      real one — yet.</em>
    </p>
    <div class="roots">
      <p class="roots-label">roots</p>
      <div>
        <p class="roots-text">
          Quechua — <em>llulla</em>, false · <em>chasqui</em>, messenger
        </p>
        <p class="roots-aside">say it out loud: it sounds like “lucky”</p>
        <a href="/the-name/" class="more">The whole story →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .name {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 4rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  @media (max-width: 68rem) {
    .name {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .figure {
    margin: 0;
  }

  /* Two panes, as the design draws it: the runner on the left, the quipu he
     carries on the right. One border around both so they read as one plate
     rather than two illustrations. */
  .panes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--bd2);
    border-radius: 14px;
    background: color-mix(in srgb, var(--panel) 40%, transparent);
    overflow: hidden;
  }

  @media (max-width: 40rem) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pane {
    position: relative;
    display: grid;
    place-items: center;
    padding: 2.5rem 1.5rem;
    min-height: 15rem;
  }

  .pane-quipu {
    border-left: 1px solid var(--bd);
  }

  .pane-label {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .pane svg {
    display: block;
    width: 100%;
    max-width: 13rem;
    height: auto;
  }

  .stroke,
  .spine,
  .cord {
    stroke: var(--viotx);
    stroke-width: 1.4;
    stroke-linecap: round;
    fill: none;
  }

  .thin {
    stroke-width: 1;
  }

  .knot {
    fill: var(--viotx);
  }

  .mark {
    fill: var(--vio);
    stroke: none;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--faint);
  }

  figcaption .sep {
    color: var(--line2);
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  h2 {
    margin: 0 0 1.75rem;
    font-family: var(--serif);
    font-size: clamp(2.375rem, 4.6vw, 3.625rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  .prose p {
    margin: 0 0 1.25rem;
    color: var(--dim);
    line-height: 1.8;
  }

  .prose em {
    font-style: italic;
    color: var(--viotx);
  }

  .pull {
    margin: 2rem 0 !important;
    font-family: var(--serif);
    font-size: 1.3125rem;
    line-height: 1.45;
    color: var(--viotx) !important;
  }

  .roots {
    display: flex;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bd);
  }

  .roots-label {
    flex: none;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .roots-text {
    margin: 0 0 0.4rem !important;
    color: var(--fg) !important;
  }

  .roots-aside {
    margin: 0 0 0.75rem !important;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint) !important;
  }

  .more {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--viotx);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
