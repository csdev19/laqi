---
// apps/site/src/components/home/TheName.astro
//
// The name, as type and nothing else.
//
// Three illustrations were tried here and all three failed for the same
// reason: each asked the reader to decode a picture before reaching the idea
// the words already carry in one line. The last one also depended on scoped
// CSS to paint an SVG, which is fragile — presentation that lives in a
// stylesheet and geometry that lives in markup have to agree, and when they
// do not the figure does not degrade, it breaks.
//
// So the left column is the wordmark at display scale. It is the one thing
// this section is about, it cannot render wrong, and it gives the name a
// moment of its own before the etymology explains it.
import BoltMark from './BoltMark.astro'
---

<section class="name" id="name">
  <div class="mark">
    <span class="tile" aria-hidden="true"><BoltMark size={40} /></span>
    <p class="word">laqi</p>
    <p class="say">/ˈla.ki/ · it sounds like “lucky”</p>
  </div>

  <div class="prose">
    <p class="eyebrow">the name</p>
    <h2>A runner, ahead of the road.</h2>
    <p>
      The <em>chasqui</em> was a relay runner of the Inca road network, carrying
      messages between waystations across the Andes.
    </p>
    <p>
      laqi plays the same role for your team. It carries the agreed API contract
      before the real backend implementation exists.
    </p>
    <p class="pull"><em>laqi carries the contract before the real API arrives.</em></p>

    <div class="roots">
      <p class="roots-label">roots</p>
      <div>
        <p class="roots-text">
          Quechua — <em>llulla</em>, false · <em>chasqui</em>, messenger
        </p>
        <a href="/the-name/" class="more">The whole story →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .name {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: 4rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  @media (max-width: 68rem) {
    .name {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .mark {
    text-align: center;
  }

  .tile {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    margin: 0 auto 1.5rem;
    border-radius: 18px;
    background: linear-gradient(145deg, var(--viol), var(--vio));
    color: #fff;
    box-shadow: 0 16px 34px -14px rgb(122 0 255 / 0.9);
  }

  .word {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--fg);
  }

  .say {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  h2 {
    margin: 0 0 1.75rem;
    font-family: var(--serif);
    font-size: clamp(2.375rem, 4.6vw, 3.625rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  .prose p {
    margin: 0 0 1.25rem;
    color: var(--dim);
    line-height: 1.8;
  }

  .prose em {
    font-style: italic;
    color: var(--viotx);
  }

  .pull {
    margin: 2rem 0 !important;
    font-family: var(--serif);
    font-size: 1.3125rem;
    line-height: 1.45;
    color: var(--viotx) !important;
  }

  /* The etymology sits under a rule, joined to nothing above it: the name's
     roots are not a derivation of the mark. */
  .roots {
    display: flex;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bd);
  }

  .roots-label {
    flex: none;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .roots-text {
    margin: 0 0 0.75rem !important;
    color: var(--fg) !important;
  }

  .more {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--viotx);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
