---
// apps/site/src/components/home/LogMock.astro
//
// The panel's request log, reproduced.
//
// Copied from packages/editor/src/styles.css rather than matched by eye: a
// flex row with an 8px gap, the time and the 46px method fixed, the path
// taking the slack, then status, the resolution, and the duration right
// aligned in 42px. A row that matched no route takes rgba(255,0,88,.09) and
// turns its path red.
//
// The resolution text is coloured by the layer that decided it — state
// magenta, scenario violet, header mint, default quiet. That mapping is the
// chapter's whole point, so it is the one thing here that must not drift.
export interface LogEntry {
  time: string
  method: string
  path: string
  status: string
  statusKind: 'ok' | 'client' | 'server'
  resolved: string
  layer: 'state' | 'scenario' | 'header' | 'default' | 'none'
  ms: string
}
interface Props {
  count: string
  entries: LogEntry[]
}
const { count, entries } = Astro.props
const METHOD_TINT: Record<string, string> = {
  GET: 'mint',
  POST: 'viol',
  PUT: 'palev',
  PATCH: 'palev',
  DELETE: 'mag',
}
---

<figure class="log">
  <div class="frame">
    <div class="bar">
      <span class="dot" aria-hidden="true"></span>
      <span class="title">requests</span>
      <span class="count">{count}</span>
    </div>

    {
      entries.map((e) => (
        <div class:list={['row', e.layer === 'none' && 'is-no-route']}>
          <span class="time">{e.time}</span>
          <span class="method" style={`color: var(--${METHOD_TINT[e.method] ?? 'dim'})`}>
            {e.method}
          </span>
          <span class="path">{e.path}</span>
          <span class:list={['status', `status-${e.statusKind}`]}>{e.status}</span>
          <span class:list={['resolved', `layer-${e.layer}`]}>{e.resolved}</span>
          <span class="ms">{e.ms}</span>
        </div>
      ))
    }
  </div>

  <slot name="float" />
</figure>

<style>
  .log {
    position: relative;
    margin: 0;
  }

  .frame {
    border: 1px solid var(--bd2);
    border-radius: 14px;
    background: var(--win);
    font-family: var(--mono);
    overflow: hidden;
    box-shadow: 0 60px 120px -40px rgb(0 0 0 / 0.8);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--bd);
    background: var(--winbar);
    font-size: 11px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }

  .title {
    color: var(--fg);
  }

  .count {
    margin-left: auto;
    color: var(--dim2);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 5px 12px;
    border-bottom: 1px solid var(--bd);
    font-size: 11px;
  }

  .row:last-of-type {
    border-bottom: 0;
  }

  .is-no-route {
    background: rgb(255 0 88 / 0.09);
  }

  .time {
    flex: none;
    color: var(--dim2);
  }

  .method {
    width: 46px;
    flex: none;
    font-weight: 600;
  }

  .path {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--fg);
  }

  .is-no-route .path {
    color: var(--red);
  }

  .status {
    flex: none;
  }

  .status-ok {
    color: var(--mint);
  }
  .status-client {
    color: var(--magl);
  }
  .status-server {
    color: var(--red);
  }

  .resolved {
    flex: none;
    max-width: 140px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--dim);
  }

  .resolved.layer-state {
    color: var(--mag);
  }
  .resolved.layer-scenario {
    color: var(--viol);
  }
  .resolved.layer-header {
    color: var(--mint);
  }
  .resolved.layer-none {
    color: var(--red);
  }

  .ms {
    width: 42px;
    flex: none;
    text-align: right;
    color: var(--dim2);
  }
</style>
