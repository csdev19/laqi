---
// apps/site/src/components/home/Why.astro
//
// The argument section: why removing the dependency is the point, drawn as a
// before/after rather than asserted.
//
// A note on what the diagram is allowed to be. It EXPLAINS the mechanism; it
// does not PROVE an outcome, and laqi has no customer evidence to prove one
// with. Everything structural in it is checkable against the repository —
// one JSON contract, laqi serving it, the switch being a base URL
// (examples/todo-app reaches laqi through a dev-server proxy, so the switch
// is one environment variable). The sprint numbers are laqi's own origin,
// which is why the prose beside the heading says "was born on" rather than
// promising a reader the same. The prose says "born on", not "gets you".
//
// The closing chips reuse the chapters' own ids, numbers and tints so they
// cannot drift from the sections they point at, and phrase them as what the
// frontend track actually gets rather than as feature names.
import { MOMENTS } from '../../lib/chapters'
import DiagramIcon from './DiagramIcon.astro'

const GETS: Record<string, string> = {
  contract: 'a contract',
  model: 'types & data',
  flip: 'every state',
  watch: 'the reason why',
  share: 'a real device',
}

const steps = [
  {
    kicker: 'sprint 0',
    tint: 'viol',
    title: 'Agree the contract',
    body: 'One JSON file, written together.',
  },
  {
    kicker: 'sprints 1–3',
    tint: 'mint',
    title: 'Build in parallel',
    body: 'Frontend against laqi. Backend against the same routes.',
  },
  {
    kicker: 'integration',
    tint: 'magl',
    title: "Switch, don't rebuild",
    body: 'Any mismatch is a contract mismatch — found in hours, not sprints.',
  },
]
---

<section class="why" id="why">
  <header class="head">
    <div>
      <p class="eyebrow">why it works</p>
      <h2>The team was ready. The API wasn't.</h2>
      <p class="sub"><em>Agree on the contract. Build everything else in parallel.</em></p>
    </div>
    <div>
      <p class="intro">
        Define the API contract once. laqi serves it immediately while the
        backend builds the real implementation.
      </p>
      <p class="origin">born on a frontend team running 2–3 sprints ahead of its backend</p>
    </div>
  </header>

  <div class="panel panel-before">
    <p class="panel-head">
      <span class="tag tag-before">before</span>
      <strong>Implementation becomes the dependency.</strong>
      <span class="aside">The frontend can't integrate until the backend exists.</span>
    </p>

    <div class="before-row">
      <div class="box">
        <DiagramIcon kind="frontend" tint="palem" />
        <div>
          <p class="box-label">frontend</p>
          <p class="box-title">Ready to build</p>
          <p class="box-meta">fetch("/todos") → ?</p>
        </div>
      </div>

      <div class="blocked" aria-hidden="true">
        <span class="line"></span>
        <span class="cross">×</span>
        <span class="line"></span>
        <span class="blocked-label">waiting for APIs</span>
      </div>

      <div class="box">
        <DiagramIcon kind="backend" tint="dim" />
        <div>
          <p class="box-label">backend</p>
          <p class="box-title">Still in development</p>
          <p class="box-meta meta-mag">sprint 3 of 5</p>
        </div>
      </div>
    </div>
  </div>

  <div class="panel panel-after">
    <p class="panel-head">
      <span class="tag tag-after">after</span>
      <strong>One contract. Two teams moving at once.</strong>
      <span class="aside">laqi serves the agreed API today. The backend implements the same contract independently.</span>
    </p>

    <p class="after-lede">
      The shapes are plain TypeScript — the one language both teams already
      share. laqi turns them into working responses today; the backend
      implements the same ones.
    </p>

    <figure class="contract">
      <figcaption class="contract-bar">
        <span class="ts">TS</span>
        <span class="contract-label">api contract</span>
        <span class="contract-file">contract/todo.ts</span>
      </figcaption>
      <pre class="contract-code"><code><span class="k">export</span> <span class="k">interface</span> <span class="t">Todo</span> {'{'}
  <span class="f">id</span>: <span class="y">string</span>;
  <span class="f">title</span>: <span class="y">string</span>;
  <span class="f">done</span>: <span class="y">boolean</span>;
{'}'}</code></pre>
      <p class="contract-foot">plain TypeScript · the common language</p>
    </figure>

    <div class="fork" aria-hidden="true">
      <span class="fork-stem"></span>
      <span class="fork-bar"></span>
    </div>

    <div class="legs" aria-hidden="true">
      <div class="leg">
        <span class="wire wire-now"></span>
        <p class="track-label is-now">frontend track</p>
        <span class="wire wire-now wire-arrow"></span>
      </div>
      <div class="leg">
        <span class="wire"></span>
        <p class="track-label">backend track</p>
        <span class="wire wire-arrow"></span>
      </div>
    </div>

    <div class="tracks">
      <div class="track track-now">
        <div class="box box-laqi">
          <DiagramIcon kind="laqi" tint="viol" />
          <div>
            <p class="box-label label-vio">laqi</p>
            <p class="box-title">Serves the contract</p>
            <p class="box-meta">temporary · every state</p>
          </div>
        </div>
        <p class="link link-now"><span class="link-text">serves now</span></p>
        <div class="box box-front">
          <DiagramIcon kind="frontend" tint="palem" />
          <div>
            <p class="box-label">frontend</p>
            <p class="box-title">Builds today</p>
            <p class="box-meta meta-mint">2–3 sprints ahead</p>
          </div>
        </div>
      </div>

      <div class="track">
        <div class="box">
          <DiagramIcon kind="backend" tint="dim" />
          <div>
            <p class="box-label">backend</p>
            <p class="box-title">Implements the contract</p>
            <p class="box-meta">in parallel</p>
          </div>
        </div>
        <p class="link"><span class="link-text">builds</span></p>
        <div class="box">
          <DiagramIcon kind="backend" tint="magl" />
          <div>
            <p class="box-label label-mag">real API</p>
            <p class="box-title">Ready later</p>
            <p class="box-meta">same routes, real data</p>
          </div>
        </div>
      </div>
    </div>

    <div class="legs legs-up" aria-hidden="true">
      <div class="leg"><span class="wire"></span></div>
      <div class="leg"><span class="wire"></span></div>
    </div>

    <div class="switch" aria-hidden="true">
      <span class="switch-head"></span>
      <span class="switch-line"></span>
      <span class="switch-word">switch</span>
      <span class="switch-line"></span>
    </div>
    <p class="switch-note">same contract · change base URL</p>

    <p class="closing">No integration rewrite. <em>Just point to the real API.</em></p>
  </div>

  <ol class="steps">
    {
      steps.map((step) => (
        <li>
          <p class="step-kicker" style={`color: var(--${step.tint})`}>{step.kicker}</p>
          <p class="step-title">{step.title}</p>
          <p class="step-body">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="coda">
    <blockquote class="pull">
      The real gain was never the mock server.<br />
      <em>It was removing a dependency from delivery.</em>
    </blockquote>
    <p class="gets">
      <span class="gets-label">what the frontend track gets</span>
      {
        MOMENTS.map((moment) => (
          <a href={`#${moment.id}`} class="get">
            <span class="get-n" style={`background: var(--${moment.tint})`}>{moment.number}</span>
            {GETS[moment.id]}
          </a>
        ))
      }
    </p>
  </div>
</section>

<style>
  .why {
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  /* ---- header ---- */

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 64rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim2);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .sub {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    color: var(--viol);
  }

  .sub em,
  .closing em,
  .pull em {
    font-style: italic;
    font-weight: 400;
  }

  .intro {
    margin: 0;
    color: var(--dim);
    line-height: 1.8;
  }

  /* ---- shared panel ---- */

  .panel {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--panel) 55%, transparent);
  }

  .panel-before {
    margin-bottom: 1.25rem;
  }

  /* The after panel is the one the reader is meant to want; a violet edge is
     how the panel marks a thing that is active, so it carries that here. */
  .panel-after {
    border-color: color-mix(in srgb, var(--vio) 55%, transparent);
    background: color-mix(in srgb, var(--vio) 4%, transparent);
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
  }

  .panel-head strong {
    font-family: var(--serif);
    font-weight: 600;
    color: var(--fg);
  }

  .panel-head .aside {
    color: var(--dim2);
  }

  .tag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag-before {
    border: 1px solid color-mix(in srgb, var(--red) 55%, transparent);
    color: var(--red);
  }

  .tag-after {
    border: 1px solid color-mix(in srgb, var(--mint) 55%, transparent);
    color: var(--mint);
  }

  /* ---- boxes ---- */

  /* Icon beside the text rather than above it: the tile is a label for the
     box, and a reader scanning the diagram should take the mark and the title
     in one movement. */
  .box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line2);
    border-radius: 10px;
    background: var(--panel);
  }

  .box-label {
    margin: 0 0 0.35rem;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim2);
  }

  .label-vio {
    color: var(--viol);
  }
  .label-mag {
    color: var(--magl);
  }

  .box-title {
    margin: 0 0 0.25rem;
    font-family: var(--serif);
    font-size: 1.0625rem;
    color: var(--fg);
  }

  .box-meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim2);
  }

  .meta-mag {
    color: var(--magl);
  }
  .meta-mint {
    color: var(--mint);
  }

  /* ---- before row ---- */

  .before-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .blocked {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .blocked .line {
    flex: 1;
    border-top: 1px dashed var(--line2);
  }

  .cross {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--red) 60%, transparent);
    border-radius: 999px;
    color: var(--red);
    font-size: 0.8125rem;
  }

  .blocked-label {
    position: absolute;
    top: calc(50% + 1.1rem);
    left: 50%;
    translate: -50% 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--dim2);
    white-space: nowrap;
  }

  @media (max-width: 54rem) {
    .before-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .blocked {
      justify-content: center;
      padding: 1.75rem 0;
    }
    .blocked .line {
      display: none;
    }
  }

  /* ---- after: contract, branch, tracks ---- */

  /* The fork from the contract down into the two tracks. Drawn with borders
     rather than an SVG so it reflows with the grid instead of being a fixed
     viewBox that stops lining up the moment the columns change width. */
  .box-laqi {
    border-color: color-mix(in srgb, var(--vio) 65%, transparent);
    background: color-mix(in srgb, var(--vio) 8%, transparent);
  }

  @media (max-width: 54rem) {
    .tracks {
      grid-template-columns: minmax(0, 1fr);
    }
    .branch {
      margin: 0 auto;
      width: 1px;
      border: 0;
      background: repeating-linear-gradient(
        to bottom,
        var(--line2) 0 3px,
        transparent 3px 6px
      );
    }
    .branch::before {
      display: none;
    }
  }


  /* ---- after: the contract card and the two tracks ---- */

  /* ---- connectors ----
     
     Everything vertical lands on a track's centre line. The tracks are a
     two-column grid, so with a gap of G and a width of W each column is
     (W - G) / 2 and the first centre sits at (W - G) / 4. The fork's bar is
     drawn from that to the second centre with the same arithmetic instead of
     a guessed percentage — 25% was close enough to look deliberate and wrong
     enough that no line met the box it pointed at. */
  .why {
    --track-gap: 1.25rem;
  }

  .fork {
    position: relative;
    height: 2.25rem;
  }

  .fork-stem {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 1.1rem;
    background: var(--line2);
  }

  .fork-bar {
    position: absolute;
    top: 1.1rem;
    left: calc((100% - var(--track-gap)) / 4);
    width: calc((100% - var(--track-gap)) / 2 + var(--track-gap));
    height: 1px;
    background: var(--line2);
  }

  /* The legs grid repeats the tracks' own template, so a leg is centred by
     the same rule that centres the box beneath it — not by a second number
     that has to be kept in step by hand. */
  .legs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--track-gap);
  }

  .leg {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
  }

  .wire {
    width: 1px;
    height: 0.9rem;
    background: var(--line2);
  }

  .wire-now {
    background: var(--mint);
  }

  /* The arrowhead belongs to the last wire of a leg, so the line and its head
     cannot drift apart when the gap changes. */
  .wire-arrow {
    position: relative;
  }

  .wire-arrow::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    translate: -50% 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--line2);
  }

  .wire-now.wire-arrow::after {
    border-top-color: var(--mint);
  }

  .track-label {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim2);
  }

  .track-label.is-now {
    color: var(--mint);
  }

  /* The legs under the tracks run upward into the switch rule, so they are
     the same element with no arrowhead. */
  .legs-up .wire {
    height: 1.5rem;
  }

  /* The connector inside a track, centred on the track rather than offset to
     the icon: the boxes either side of it are full width, so their shared
     centre is the only line that reads as joining them. */
  .link {
    position: relative;
    height: 2.5rem;
    margin: 0;
  }

  .link::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0.45rem;
    left: 50%;
    width: 1px;
    background: var(--line2);
  }

  .link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--line2);
  }

  .link-text {
    position: absolute;
    top: 50%;
    left: calc(50% + 0.75rem);
    translate: 0 -50%;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--dim2);
  }

  .link-now::before {
    background: var(--mint);
  }

  .link-now::after {
    border-top-color: var(--mint);
  }

  .link-now .link-text {
    color: var(--mint);
  }

  /* The switch rule spans the two centres like the fork's bar, and its head
     points left: the frontend is the side that changes. */
  .switch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: calc((100% - var(--track-gap)) / 2 + var(--track-gap));
    margin-left: calc((100% - var(--track-gap)) / 4);
  }

  .switch-head {
    flex: none;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-right: 5px solid var(--line2);
  }

  .switch-line {
    flex: 1;
    border-top: 1px dashed var(--line2);
  }

  .switch-word {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .after-lede {
    max-width: 52rem;
    margin: 0 0 2.5rem;
    color: var(--dim);
    line-height: 1.75;
  }

  /* The contract as a file rather than a chip: a reader recognises a code
     card instantly, and the point of the section is that both teams are
     reading the same source. */
  .contract {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    border: 1px solid color-mix(in srgb, var(--vio) 65%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--vio) 7%, transparent);
    overflow: hidden;
  }

  .contract-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--vio) 35%, transparent);
    font-family: var(--mono);
    font-size: 0.6875rem;
  }

  .ts {
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: #3178c6;
    color: #fff;
    font-size: 0.625rem;
    font-weight: 600;
  }

  .contract-label {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--viol);
  }

  .contract-file {
    margin-left: auto;
    padding-left: 2rem;
    color: var(--dim2);
  }

  .contract-code {
    margin: 0;
    padding: 1rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--dim);
    overflow-x: auto;
  }

  .contract-code .k {
    color: var(--magl);
  }
  .contract-code .t {
    color: var(--warn);
  }
  .contract-code .f {
    color: var(--palev);
  }
  .contract-code .y {
    color: var(--palem);
  }

  .contract-foot {
    margin: 0;
    padding: 0.5rem 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--vio) 25%, transparent);
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-align: center;
    color: var(--dim2);
  }

  /* The fork, drawn with borders so it reflows with the grid instead of
     being a fixed viewBox that stops lining up when the columns change. */
  .tracks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .track {
    display: grid;
  }

  .box-laqi {
    border-color: color-mix(in srgb, var(--vio) 70%, transparent);
    border-style: dashed;
    background: color-mix(in srgb, var(--vio) 9%, transparent);
  }

  .box-front {
    border-color: color-mix(in srgb, var(--mint) 45%, transparent);
    background: color-mix(in srgb, var(--mint) 4%, transparent);
  }

  /* The connector between a track's two boxes, with the verb it performs
     written beside it — an arrow alone says "then", which is weaker than
     "serves now". */
  /* The switch back: one dashed rule under both tracks, pointing at the
     frontend, because that is the side that changes. */
  .switch-note {
    margin: 0.6rem 0 0;
    padding-left: calc((100% - var(--track-gap)) / 4);
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-align: center;
    color: var(--dim2);
  }

  @media (max-width: 54rem) {
    .tracks,
    .legs {
      grid-template-columns: minmax(0, 1fr);
    }
    /* One column: the bar has nothing to span and the switch runs the full
       width, so both drop their two-column arithmetic. */
    .fork-bar {
      display: none;
    }
    .switch {
      width: 100%;
      margin-left: 0;
    }
    .switch-note {
      padding-left: 0;
    }
    .branch {
      margin: 0 auto;
      width: 1px;
      border: 0;
      background: var(--line2);
    }
    .branch::before {
      display: none;
    }
  }

  .closing {
    margin: 1.75rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    text-align: center;
    color: var(--fg);
  }

  .closing em {
    color: var(--viol);
  }

  /* ---- steps ---- */

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
    margin: 4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line2);
  }

  .step-kicker {
    margin: 0 0 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .step-title {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-size: 1.1875rem;
    color: var(--fg);
  }

  .step-body {
