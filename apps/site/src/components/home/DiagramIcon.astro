---
// apps/site/src/components/home/DiagramIcon.astro
//
// The three marks the before/after diagram labels its boxes with. Inline SVG
// on a tinted tile rather than an icon font or a sprite: there are three of
// them, they are drawn once, and they take the tint of whatever box they sit
// in through currentColor.
//
// A window for anything a person looks at, stacked layers for anything that
// serves, the product's own bolt for laqi. Nothing else gets an icon — a mark
// per box would make them decoration again.
interface Props {
  kind: 'frontend' | 'backend' | 'laqi' | 'contract' | 'person' | 'branch' | 'people'
  tint: string
}
const { kind, tint } = Astro.props
---

<span class="tile" style={`--tint: var(--${tint})`} aria-hidden="true">
  {
    kind === 'frontend' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="4" width="18" height="16" rx="2.5" />
        <path d="M3 9h18" />
        <path d="M7 13h7M7 16h4" stroke-linecap="round" />
      </svg>
    )
  }
  {
    kind === 'backend' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="3.5" width="18" height="5.5" rx="1.8" />
        <rect x="3" y="11" width="18" height="5.5" rx="1.8" />
        <path d="M6.5 6.25h.01M6.5 13.75h.01" stroke-linecap="round" stroke-width="2.2" />
        <path d="M7 19.5h10" stroke-linecap="round" />
      </svg>
    )
  }
  {
    kind === 'laqi' && (
      <svg viewBox="0 0 210 309" fill="currentColor" class="bolt">
        <path d="M149 0L0 171H63L49.5 309L210 127H135L149 0Z" />
      </svg>
    )
  }
  {
    kind === 'person' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="12" cy="8" r="3.4" />
        <path d="M5.5 20a6.5 6.5 0 0 1 13 0" stroke-linecap="round" />
      </svg>
    )
  }
  {
    kind === 'branch' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="7" cy="5.5" r="2.4" />
        <circle cx="7" cy="18.5" r="2.4" />
        <circle cx="17" cy="9" r="2.4" />
        <path d="M7 8v8" stroke-linecap="round" />
        <path d="M17 11.5c0 3-4 3.5-7 4" stroke-linecap="round" />
      </svg>
    )
  }
  {
    kind === 'people' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="9" cy="8.5" r="3" />
        <circle cx="16.5" cy="9.5" r="2.2" />
        <path d="M3.5 19a5.5 5.5 0 0 1 11 0" stroke-linecap="round" />
        <path d="M16 15.5a4.5 4.5 0 0 1 4.5 3.5" stroke-linecap="round" />
      </svg>
    )
  }
  {kind === 'contract' && <span class="braces">{'{}'}</span>}
</span>

<style>
  .tile {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--tint) 35%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--tint) 10%, transparent);
    color: var(--tint);
  }

  .tile svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* The bolt is taller than it is wide, so it cannot take the square box the
     other two marks sit in without being stretched. */
  .tile svg.bolt {
    width: 0.85rem;
    height: 1.25rem;
  }

  .braces {
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
