---
// apps/site/src/pages/index.astro
//
// The home page is nine sections walked top to bottom, with a fixed rail on
// the right tracking which one you are in. The chapter list in
// src/lib/chapters.ts is the single source for the rail, the overview chips
// and the section ids — add a section there, not here.
import '../styles/global.css'
import TopNav from '../components/home/TopNav.astro'
import Hero from '../components/home/Hero.astro'
import Why from '../components/home/Why.astro'
import Chapter from '../components/home/Chapter.astro'
import Window from '../components/home/Window.astro'
import CodeWindow from '../components/home/CodeWindow.astro'
import CreateRow from '../components/home/CreateRow.astro'
import PanelMock from '../components/home/PanelMock.astro'
import FloatCard from '../components/home/FloatCard.astro'
import TheName from '../components/home/TheName.astro'
import Start from '../components/home/Start.astro'
import Rail from '../components/home/Rail.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { MOMENTS } from '../lib/chapters'

const total = String(MOMENTS.length).padStart(2, '0')

const title = 'laqi — build the frontend, the backend can wait'
const description =
  'laqi is a local mock server with a control panel. It answers your app from plain JSON files in your repo, and flips any endpoint into any state — empty, 401, 500, slow — in one click.'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href="https://laqi.dev/" />
    <meta name="theme-color" content="#0b0a0f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="laqi" />
    <meta property="og:url" content="https://laqi.dev/" />
    <meta property="og:title" content="Build the frontend. The backend can wait." />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://laqi.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Build the frontend. The backend can wait." />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://laqi.dev/og-image.png" />
  </head>
  <body class="textured">
    <TopNav />
    <Rail />

    <main>
      <Hero />
      <Why />

      <Chapter
        id="contract"
        number="01"
        total={total}
        kicker="contract · plain JSON"
        tint="vio"
        title="Agree the API once."
        subtitle="Then both sides build against it."
        chips={['named responses', 'lives in git', 'import OpenAPI']}
        noteLabel="the shift"
      >
        <span slot="glyph">{'{}'}</span>
        <p slot="body">
          Routes are defined once. Each named response is a state that matters.
          The file lives in git — the frontend serves it with laqi today, the
          backend implements the same interface.
        </p>
        <Fragment slot="note">
          The contract becomes the dependency — not the backend implementation.
        </Fragment>
        <CodeWindow
          file="laqi/api.json"
          meta="saved 2s ago"
          lines={[
            { html: '<span class="p">{</span>' },
            { html: '&nbsp;&nbsp;<span class="key">"GET /todos"</span><span class="p">: {</span>', note: 'route · defined once' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"default"</span><span class="p">:</span> <span class="str">"ok"</span><span class="p">,</span>' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"responses"</span><span class="p">: {</span>', note: 'named states' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"ok"</span><span class="p">:</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="p">{</span> <span class="key">"body"</span><span class="p">: [{</span> <span class="key">"id"</span><span class="p">:</span> <span class="num">1</span> <span class="p">}] },</span>' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"empty"</span><span class="p">:</span> <span class="p">{</span> <span class="key">"body"</span><span class="p">: [] },</span>' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"slow"</span><span class="p">:</span>&nbsp;&nbsp;<span class="p">{</span> <span class="key">"delay"</span><span class="p">:</span> <span class="num">2400</span> <span class="p">},</span>' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="key">"error"</span><span class="p">:</span> <span class="p">{</span> <span class="key">"status"</span><span class="p">:</span> <span class="num">500</span> <span class="p">}</span>', note: '← a state that matters' },
            { html: '&nbsp;&nbsp;&nbsp;&nbsp;<span class="p">}</span>' },
            { html: '&nbsp;&nbsp;<span class="p">}</span>' },
            { html: '<span class="p">}</span>' },
          ]}
          footer={[
            { label: 'frontend', text: 'laqi start → served now', tint: 'palem' },
            { label: 'backend', text: 'implements the same routes' },
          ]}
        >
          <FloatCard slot="float" label="reloaded">
            <p><code>GET /todos</code> · 4 responses</p>
            <p class="live">↻ live in 12ms</p>
          </FloatCard>
        </CodeWindow>
      </Chapter>

      <Chapter
        id="model"
        number="02"
        total={total}
        kicker="model · from types to responses"
        tint="viol"
        title="Start from your types."
        subtitle="laqi writes the responses."
        chips={['from a model', 'from JSON', 'from a schema in the project', 'copy types']}
        noteLabel="why it matters"
      >
        <span slot="glyph">T→{'{}'}</span>
        <p slot="body">
          Paste a TypeScript interface, point at a schema already in your
          project, or drop in sample JSON. laqi generates realistic data that
          fits it — and goes the other way too, giving you types for any
          response.
        </p>
        <Fragment slot="note">
          The mock and the frontend’s types can’t drift apart — they come from
          the same model.
        </Fragment>
        <CreateRow>
          <FloatCard label="and back again · copy types">
            <p>
              <code
                ><span class="kw">export</span> <span class="kw">interface</span>
                <span class="typ">AuthSignup</span></code
              >
            </p>
            <p class="live">{'{ token: string; user: User }'}</p>
          </FloatCard>
        </CreateRow>
      </Chapter>

      <Chapter
        id="flip"
        number="03"
        total={total}
        kicker="flip · every edge case, on demand"
        tint="mag"
        title="What if it fails?"
        subtitle="Find out before the backend can tell you."
        chips={['500 error', '401 unauthorized', '422 validation', 'empty list', 'slow · 3s', 'offline scenario']}
        noteLabel="the point"
      >
        <span slot="glyph">500</span>
        <p slot="body">
          Test the states you usually have to wait for — or can never get on
          purpose. Pick one, and your app’s next ordinary request gets it.
          Nothing restarts, and your app does not know the difference.
        </p>
        <Fragment slot="note">
          The error path stops being the one nobody ever sees until a user does.
        </Fragment>
        <PanelMock
          watching="examples/todo-app/laqi"
          address="127.0.0.1:8000"
          overridden={1}
          scenarios={[
            { name: 'logged-out' },
            { name: 'offline', count: 3, active: true },
            { name: 'slow-network' },
          ]}
          rows={[
            {
              method: 'GET',
              path: '/todos',
              description: 'The whole list',
              layer: 'scenario',
              live: 2,
              chips: [
                { name: 'ok', status: '200', kind: 'ok' },
                { name: 'empty', status: '200', kind: 'ok' },
                { name: 'error', status: '500', kind: 'server' },
              ],
            },
            {
              method: 'POST',
              path: '/todos',
              description: 'Create a todo',
              layer: 'scenario',
              live: 1,
              chips: [
                { name: 'created', status: '201', kind: 'ok' },
                { name: 'error', status: '500', kind: 'server' },
              ],
            },
            {
              method: 'GET',
              path: '/profile',
              description: 'The signed-in user',
              layer: 'default',
              live: 0,
              chips: [
                { name: 'ok', status: '200', kind: 'ok' },
                { name: 'unauthorized', status: '401', kind: 'client' },
              ],
            },
            {
              method: 'GET',
              path: '/health',
              description: 'Liveness',
              layer: 'state',
              live: 0,
              chips: [
                { name: 'ok', status: '200', kind: 'ok' },
                { name: 'error', status: '500', kind: 'server' },
              ],
            },
            {
              method: 'POST',
              path: '/session',
              description: 'Sign in',
              layer: 'default',
              live: 0,
              chips: [
                { name: 'ok', status: '200', kind: 'ok' },
                { name: 'invalid', status: '401', kind: 'client' },
              ],
            },
          ]}
        >
          <FloatCard label="what happens next">
            <p><span class="step-n">1</span> you pick <span class="pick">error</span></p>
            <p><span class="step-n">2</span> app sends <code>POST /todos</code>, as usual</p>
            <p><span class="step-n">3</span> laqi returns <span class="err">500</span></p>
            <p class="live"><span class="step-n">4</span> your error UI gets tested</p>
          </FloatCard>
        </PanelMock>
      </Chapter>

      <Chapter
        id="watch"
        number="04"
        total={total}
        kicker="watch · resolution, explained"
        tint="mint"
        title="Every request tells you why."
        subtitle="No guessing which rule won."
        chips={['header', 'state', 'scenario', 'default']}
        noteLabel="same answer, three places"
      >
        <span slot="glyph">↻</span>
        <p slot="body">
          Each line shows what came back and what chose it — a header on one
          request, a state you picked in the panel, the active scenario, or
          what the file says. Requests that matched no route show up too. That
          one is usually the bug.
        </p>
        <Fragment slot="note">
          The panel, the terminal and the <code>x-laqi-resolved</code> header
          always say the same thing.
        </Fragment>
        <Window
          label="requests"
          meta="218"
          footer={[
            { label: 'always agrees', text: 'panel · terminal · x-laqi-resolved', tint: 'palem' },
          ]}
        >
          <div class="panel-rows">
            {
              [
                { t: '09:15:25', m: 'GET', c: 'mint', path: '/todos', s: '200', sc: 'mint', why: 'state → empty' },
                { t: '09:15:28', m: 'POST', c: 'vio', path: '/todos', s: '500', sc: 'red', why: 'scenario → error' },
                { t: '09:15:31', m: 'GET', c: 'mint', path: '/todos', s: '200', sc: 'mint', why: 'header → slow' },
                { t: '09:15:33', m: 'GET', c: 'mint', path: '/profile', s: '401', sc: 'magl', why: 'state → unauthorized' },
                { t: '09:15:36', m: 'PATCH', c: 'palev', path: '/todos/12', s: '200', sc: 'mint', why: 'default → ok' },
                { t: '09:15:38', m: 'GET', c: 'mint', path: '/favicon.ico', s: '404', sc: 'red', why: 'no matching route', miss: true },
              ].map((row) => (
                <p class:list={['lrow', row.miss && 'lrow-miss']}>
                  <span class="t">{row.t}</span>
                  <span class="m" style={`color: var(--${row.c})`}>{row.m}</span>
                  <span class="path">{row.path}</span>
                  <span class="s" style={`color: var(--${row.sc})`}>{row.s}</span>
                  <span class="why">{row.why}</span>
                </p>
              ))
            }
          </div>
          <FloatCard slot="float" label="same answer, three places">
            <p>panel&nbsp;&nbsp;&nbsp;&nbsp;<code>scenario → error</code></p>
            <p>terminal <code>scenario → error</code></p>
            <p class="live">header&nbsp;&nbsp;&nbsp;<code>x-laqi-resolved: error</code></p>
          </FloatCard>
        </Window>
      </Chapter>

      <Chapter
        id="share"
        number="05"
        total={total}
        kicker="share · a public URL"
        tint="palev"
        title="Localhost, anywhere."
        subtitle="Test on a real device. Deploy nothing."
        chips={['explicit', 'temporary', 'token-protected', 'off by default']}
        noteLabel="without it"
      >
        <span slot="glyph">◉</span>
        <p slot="body">
          <code>laqi --share</code> opens a temporary public URL through a
          Cloudflare tunnel, so a phone, a tester or a teammate on another
          network reaches the same mocks — and every request still shows up in
          your own log. Only the mock responses travel: the panel and its write
          API are not mounted on that listener at all.
        </p>
        <Fragment slot="note">
          You would be deploying a throwaway backend just so a phone could
          reach it.
        </Fragment>
        <Window
          label="zsh — laqi"
          meta="public url open"
          footer={[
            { label: 'travels', text: 'mock responses only', tint: 'palem' },
            { label: 'stays local', text: 'the panel and its write API' },
          ]}
        >
          <div class="term">
            <p><span class="dim">$</span> laqi --share</p>
            <p class="gap"></p>
            <p><span class="dim">serving&nbsp;&nbsp;</span> 127.0.0.1:8000</p>
            <p><span class="dim">panel&nbsp;&nbsp;&nbsp;&nbsp;</span> 127.0.0.1:8000/__laqi <span class="dim">local only</span></p>
            <p>
              <span class="dim">public&nbsp;&nbsp;&nbsp;</span>
              <span class="url">https://cold-relay-7f2a.trycloudflare.com</span>
            </p>
            <p><span class="dim">token&nbsp;&nbsp;&nbsp;&nbsp;</span> lq_7f2a41c8d93b <span class="dim">240 req/min</span></p>
          </div>
          <FloatCard slot="float" label="from the phone">
            <p>09:22:04 <code>GET /todos</code> <span class="ok">200</span> via public</p>
            <p>09:22:06 <code>POST /todos</code> <span class="err">500</span> via public</p>
            <p class="live">every request still lands in your own log</p>
          </FloatCard>
        </Window>
      </Chapter>

      <section class="files" id="files">
        <div class="files-inner">
          <div>
            <p class="eyebrow">your files</p>
            <h2>Local by default. <em>Just files in your repo.</em></h2>
            <ul class="checks">
              <li>
                <strong>Runs on 127.0.0.1 by default.</strong> No account, no hosted
                project, no telemetry.
              </li>
              <li>
                <strong>Your mocks are plain files.</strong> Commit them, review them,
                diff them, clone them.
              </li>
              <li>
                <strong>The panel edits the same files.</strong> One source of truth.
              </li>
              <li>
                <strong>Sharing is explicit.</strong> Public access only exists while
                you have a temporary tunnel open.
              </li>
            </ul>
          </div>
          <Window label="todo-app" meta="main">
            <pre><code>{`laqi/
  api.json                           +12  -3
  scenarios.json              3 scenarios
src/
package.json        "mock": "laqi start"

@@ "POST /todos" @@
+ "validation": { "status": 422, "body": {…} },
- "error":      { "status": 500 }`}</code></pre>
          </Window>
        </div>
      </section>

      <TheName />

      <Start />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .files {
    border-top: 1px solid var(--bd);
    background: color-mix(in srgb, var(--panel) 40%, transparent);
  }

  .files-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 4rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  @media (max-width: 68rem) {
    .files-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  /* A tick per line rather than a bullet: each row is a property of the
     product that holds, not an item in a list of features. */
  .checks {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    position: relative;
    padding: 0 0 1.1rem 1.75rem;
    color: var(--dim);
    line-height: 1.7;
  }

  .checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--palem);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .checks strong {
    font-weight: 400;
    color: var(--fg);
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  h2 {
    margin: 0 0 1.25rem;
    font-family: var(--serif);
    font-size: clamp(2.375rem, 4.6vw, 3.625rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  h2 em {
    font-style: italic;
    font-weight: 400;
    color: var(--viotx);
  }


  /* ---- the evidence windows ----
     Rows inside a product window: a panel's endpoints, a request log, a
     terminal. Each is its own small grid so a column lines up down the
     window rather than per row. */
  :global(.panel-rows) {
    padding: 0.35rem 0;
  }

  :global(.scenarios) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.5rem 1rem 0.7rem;
    border-bottom: 1px solid var(--bd);
  }

  :global(.sc-label) {
    margin-right: 0.4rem;
    font-size: 0.5938rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--dim2);
  }

  :global(.sc) {
    padding: 0.1rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 2px;
    color: var(--dim2);
  }

  :global(.sc-on) {
    border-color: color-mix(in srgb, var(--vio) 60%, transparent);
    background: color-mix(in srgb, var(--vio) 14%, transparent);
    color: var(--viotx);
  }

  :global(.prow) {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 4.5rem;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.4rem 1rem;
  }

  :global(.prow .path),
  :global(.lrow .path) {
    color: var(--fg);
  }

  :global(.prow .chips) {
    display: flex;
    gap: 0.3rem;
  }

  :global(.prow .chip) {
    padding: 0.08rem 0.4rem;
    border: 1px solid transparent;
    border-radius: 2px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    color: var(--dim2);
  }

  /* Magenta is the panel's own colour for a state someone set. */
  :global(.prow .chip-on) {
    border-color: color-mix(in srgb, var(--mag) 55%, transparent);
    background: color-mix(in srgb, var(--mag) 12%, transparent);
    color: var(--magtx);
  }

  :global(.prow .layer) {
    font-size: 0.5938rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: right;
    color: var(--dim2);
  }

  :global(.lrow) {
    display: grid;
    grid-template-columns: 4.5rem 3.25rem minmax(0, 1fr) 2.5rem auto;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.35rem 1rem;
  }

  :global(.lrow .t),
  :global(.lrow .why) {
    color: var(--dim2);
  }

  /* The request that matched nothing is the one worth finding, so it is the
     only row the log marks. */
  :global(.lrow-miss) {
    background: color-mix(in srgb, var(--red) 8%, transparent);
  }

  :global(.lrow-miss .path) {
    color: var(--red);
  }

  :global(.term) {
    padding: 0.9rem 1rem;
  }

  :global(.term p) {
    margin: 0;
  }

  :global(.term .gap) {
    height: 0.5rem;
  }

  :global(.term .dim) {
    color: var(--dim2);
  }

  :global(.term .url) {
    color: var(--palem);
  }

  :global(.float .body .step-n) {
    display: inline-block;
    width: 1rem;
    color: var(--dim2);
  }

  :global(.float .body .ok) {
    color: var(--mint);
  }

  :global(.float .body .err) {
    color: var(--red);
  }

  :global(.float .body .pick) {
    color: var(--magtx);
  }

  :global(.float .body p) {
    margin: 0;
  }

  :global(.float .body code) {
    font-family: var(--mono);
    color: var(--fg);
  }

  :global(.float .body .live) {
    color: var(--palem);
  }
</style>
