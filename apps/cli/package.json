{
  "name": "laqi",
  "version": "2.0.0",
  "description": "A controllable local mock API server for frontend development. Flip responses, errors, latency, and scenarios from a web panel.",
  "keywords": [
    "api-mocking",
    "frontend",
    "local-development",
    "mcp",
    "mock-api",
    "mock-server",
    "openapi",
    "react-native",
    "testing"
  ],
  "homepage": "https://laqi.dev",
  "bugs": {
    "url": "https://github.com/csdev19/laqi/issues"
  },
  "license": "MIT",
  "author": "Cristian Sotomayor (https://github.com/csdev19)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csdev19/laqi.git"
  },
  "bin": {
    "laqi": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts --dir ../../examples/todo-app/laqi",
    "check-types": "tsc --noEmit -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^1.19.7",
    "chokidar": "^4.0.3",
    "effect": "^3.22.1",
    "hono": "4.12.3",
    "quicktype-core": "^26.0.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "@laqi/core": "workspace:*",
    "@laqi/editor": "workspace:*",
    "@laqi/generate": "workspace:*",
    "@laqi/mcp": "workspace:*",
    "@laqi/schema": "workspace:*",
    "@laqi/server": "workspace:*",
    "@laqi/tui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "tsdown": "0.18.4"
  },
  "engines": {
    "node": ">=20"
  }
}
