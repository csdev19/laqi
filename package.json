{
  "name": "laqi-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "hono": "4.12.3",
      "zod": "4.3.6",
      "typescript": "5.9.3",
      "tsdown": "0.18.4",
      "@types/bun": "^1.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "bun run lint && bun run format",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "vitest": "^2.1.0"
  },
  "packageManager": "bun@1.3.4"
}
