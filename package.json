{
  "name": "laqi-monorepo",
  "version": "2.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "hono": "4.12.3",
      "zod": "4.3.6",
      "typescript": "5.9.3",
      "tsdown": "0.18.4",
      "@types/bun": "^1.3.4",
      "vitest": "^2.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "bun run lint && bun run format",
    "check:ci": "oxlint && oxfmt --check .",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check-types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run check:ci && bun run build && bun run check-types && bun run check-types:scripts && bun run test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "linkinator": "^8.1.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "vitest": "^2.1.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "bun@1.3.4"
}
